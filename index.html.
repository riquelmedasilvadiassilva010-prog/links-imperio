<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Império Barber Shop - Links</title>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
        }

        body {
            background-color: #0d0d0d;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }

        /* Fundo desfocado */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.95)), 
                        url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&q=80') center/cover no-repeat;
            z-index: -1;
        }

        .container {
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        /* Header e Logo */
        .header {
            margin-bottom: 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-crown {
            color: #d4af37;
            font-size: 2rem;
            margin-bottom: 5px;
            filter: drop-shadow(0 0 5px rgba(212, 175, 55, 0.5));
        }

        .logo-box {
            border: 2px solid #d4af37;
            padding: 10px 20px;
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.6);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
            position: relative;
            margin-bottom: 15px;
        }

        .logo-text {
            font-family: 'Cinzel', serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo-text span {
            color: #d4af37;
        }

        .slogan {
            font-size: 0.8rem;
            letter-spacing: 2px;
            color: #d4af37;
            font-weight: 700;
            text-transform: uppercase;
            position: relative;
            display: inline-block;
        }

        .slogan::before, .slogan::after {
            content: "—";
            margin: 0 8px;
            opacity: 0.7;
        }

        /* Grid de Links */
        .links-container {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
        }

        .link-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(15, 15, 15, 0.85);
            border: 1px solid #d4af37;
            border-radius: 18px;
            padding: 12px 20px;
            text-decoration: none;
            color: #ffffff;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        }

        .link-card:hover {
            background: #d4af37;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
        }

        .link-card:hover .link-title { color: #000000; }
        .link-card:hover .link-subtitle { color: #222222; }
        .link-card:hover .arrow-icon { color: #000000; }

        .link-left {
            display: flex;
            align-items: center;
            gap: 15px;
            text-align: left;
        }

        .icon-box {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        /* Cores dos Ícones */
        .whatsapp-bg { background-color: #25D366; color: white; }
        .instagram-bg { background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); color: white; }
        .google-bg { background-color: #ffffff; color: #4285F4; }
        .pix-bg { background-color: #32BCAD; color: white; }
        .wifi-bg { background-color: #d4af37; color: black; }

        .link-info {
            display: flex;
            flex-direction: column;
        }

        .link-title {
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: color 0.3s;
        }

        .link-subtitle {
            font-size: 0.75rem;
            color: #aaaaaa;
            margin-top: 2px;
            transition: color 0.3s;
        }

        .arrow-icon {
            color: #d4af37;
            font-size: 1.1rem;
            transition: color 0.3s;
        }

        /* Cartão Wi-Fi */
        .wifi-card {
            width: 100%;
            background: rgba(15, 15, 15, 0.9);
            border: 1px solid #d4af37;
            border-radius: 18px;
            padding: 15px 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
            margin-bottom: 25px;
        }

        .wifi-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .wifi-item {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-grow: 1;
        }

        .wifi-item i {
            color: #d4af37;
            font-size: 1.4rem;
            width: 25px;
            text-align: center;
        }

        .wifi-details {
            display: flex;
            flex-direction: column;
            text-align: left;
            flex-grow: 1;
        }

        .wifi-label {
            font-size: 0.7rem;
            color: #888;
            text-transform: uppercase;
        }

        .wifi-value-input {
            background: #181818;
            border: 1px solid #333;
            border-radius: 8px;
            color: #fff;
            padding: 6px 10px;
            font-size: 0.85rem;
            font-weight: 600;
            width: 100%;
            margin-top: 2px;
            outline: none;
        }

        .copy-btn {
            background: rgba(212, 175, 55, 0.15);
            border: 1px solid #d4af37;
            color: #d4af37;
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.75rem;
        }

        .copy-btn:hover {
            background: #d4af37;
            color: #000;
        }

        /* Rodapé */
        .footer-brand {
            font-family: 'Cinzel', serif;
            color: #d4af37;
            font-size: 0.85rem;
            letter-spacing: 1.5px;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .footer-tagline {
            font-size: 0.65rem;
            color: #888;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Toast Alert */
        .toast {
            position: fixed;
            bottom: 20px;
            background: #d4af37;
            color: #000;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: 600;
            font-size: 0.85rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s ease;
            pointer-events: none;
            z-index: 100;
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Logo -->
        <header class="header">
            <div class="logo-crown"><i class="fa-solid fa-crown"></i></div>
            <div class="logo-box">
                <div class="logo-text">★ IMPÉRIO <span>BARBER SHOP</span> ★</div>
            </div>
            <div class="slogan">Mais que um corte, é o seu estilo!</div>
        </header>

        <!-- Links (SUBSTITUA OS LINKS ABAIXO PELOS TEUS) -->
        <div class="links-container">
            <!-- Coloca o teu número do WhatsApp com código do país (ex: 351 para PT ou 55 para BR) -->
            <a href="https://wa.me/351900000000" target="_blank" class="link-card">
                <div class="link-left">
                    <div class="icon-box whatsapp-bg"><i class="fa-brands fa-whatsapp"></i></div>
                    <div class="link-info">
                        <span class="link-title">CHAMA NO WHATSAPP</span>
                        <span class="link-subtitle">Agende seu horário</span>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
            </a>

            <!-- Teu utilizador do Instagram -->
            <a href="https://instagram.com/teu_instagram" target="_blank" class="link-card">
                <div class="link-left">
                    <div class="icon-box instagram-bg"><i class="fa-brands fa-instagram"></i></div>
                    <div class="link-info">
                        <span class="link-title">NOSSO INSTAGRAM</span>
                        <span class="link-subtitle">Acompanhe nosso trabalho</span>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
            </a>

            <!-- Teu link de avaliações do Google Meu Negócio -->
            <a href="https://google.com" target="_blank" class="link-card">
                <div class="link-left">
                    <div class="icon-box google-bg"><i class="fa-brands fa-google"></i></div>
                    <div class="link-info">
                        <span class="link-title">AVALIE NO GOOGLE</span>
                        <span class="link-subtitle">Sua opinião é muito importante</span>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
            </a>

            <!-- Link do Pix ou Chave -->
            <a href="#" class="link-card">
                <div class="link-left">
                    <div class="icon-box pix-bg"><i class="fa-solid fa-qrcode"></i></div>
                    <div class="link-info">
                        <span class="link-title">PAGUE COM PIX</span>
                        <span class="link-subtitle">Rápido e seguro</span>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
            </a>

            <!-- Scroll para o Wi-Fi -->
            <a href="#wifi-section" class="link-card">
                <div class="link-left">
                    <div class="icon-box wifi-bg"><i class="fa-solid fa-wifi"></i></div>
                    <div class="link-info">
                        <span class="link-title">WI-FI GRÁTIS</span>
                        <span class="link-subtitle">Conecte-se enquanto espera</span>
                    </div>
                </div>
                <i class="fa-solid fa-chevron-right arrow-icon"></i>
            </a>
        </div>

        <!-- Bloco Wi-Fi -->
        <div class="wifi-card" id="wifi-section">
            <div class="wifi-row">
                <div class="wifi-item">
                    <i class="fa-solid fa-wifi"></i>
                    <div class="wifi-details">
                        <span class="wifi-label">Rede Wi-Fi</span>
                        <input type="text" readonly value="Império Barber Shop" id="wifi-ssid" class="wifi-value-input">
                    </div>
                </div>
                <button class="copy-btn" onclick="copyValue('wifi-ssid', 'Nome da rede')">
                    <i class="fa-regular fa-copy"></i>
                </button>
            </div>

            <div class="wifi-row">
                <div class="wifi-item">
                    <i class="fa-solid fa-lock"></i>
                    <div class="wifi-details">
                        <span class="wifi-label">Senha</span>
                        <input type="text" readonly value="@imperio123" id="wifi-pass" class="wifi-value-input">
                    </div>
                </div>
                <button class="copy-btn" onclick="copyValue('wifi-pass', 'Senha')">
                    <i class="fa-regular fa-copy"></i>
                </button>
            </div>
        </div>

        <!-- Rodapé -->
        <footer class="footer">
            <div class="footer-brand">
                <i class="fa-solid fa-crown" style="font-size: 0.7rem;"></i>
                IMPÉRIO BARBER SHOP
                <i class="fa-solid fa-crown" style="font-size: 0.7rem;"></i>
            </div>
            <div class="footer-tagline">Qualidade • Respeito • Estilo</div>
        </footer>
    </div>

    <div id="toast" class="toast">Copiado para a área de transferência!</div>

    <script>
        function copyValue(elementId, labelText) {
            const input = document.getElementById(elementId);
            input.select();
            input.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(input.value).then(() => {
                showToast(`${labelText} copiada com sucesso!`);
            });
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(() => { toast.classList.remove('show'); }, 2500);
        }
    </script>
</body>
</html>
